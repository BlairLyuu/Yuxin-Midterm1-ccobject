  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Chapter 3 | Robot Dreams: Letting Go\n\nWhat hurts most about Robot Dreams
    is that it doesn\u2019t frame separation as betrayal, or regret as failure. It
    simply says, calmly: even with love and sincerity, two beings may still not make
    it to the end together. When she watched it before she had fully healed from
    her breakup, her first response was ache and loss\u2014because she saw herself
    in it. Even when she knew they weren\u2019t right for each other, she still grieved.
    Even when she believed there was nothing to regret, she still replayed certain
    nights in her head. The film gently helps her accept this: pain doesn\u2019t
    mean it was wrong, and letting go doesn\u2019t mean denying what was real. It
    feels like a soft push forward\u2014allowing her to carry the regret and still
    keep living, slowly turning her face toward a brighter, more open future."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fb31704cec070074ca40032b135cceca, type: 2}
  m_sharedMaterial: {fileID: -2758856410231806141, guid: fb31704cec070074ca40032b135cceca, type: 2}
