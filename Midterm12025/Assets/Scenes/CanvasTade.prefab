  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Chapter 1 | Her Memories: Immersion\n\nHer Memories feels like a room
    that only lights up in the dark. It doesn\u2019t rush to explain the plot; it
    lets emotion arrive first: certain fragments return again and again, certain
    sentences stop halfway\u2014like the way real remembering works. The more someone
    tries to hold onto it, the more it slips away. She came to New York in the summer
    of 2024, and Metrograph became her most reliable shelter. The moment she sat
    down in the theater, reality was muted, and she could safely hand herself over
    to memory. That brief but painful relationship happened before spring 2025. She
    wasn\u2019t trying to build something long-term\u2014she was simply lonely, wanting
    someone beside her. Her Memories captures this clearly: even when people know
    something is unstable, they still fall in. They turn a crack into an entrance,
    and turn longing into a way of living."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fb31704cec070074ca40032b135cceca, type: 2}
